---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait-hero.png';
import cvUrl from '../content/Farhat_Anjam_CV.pdf?url';
import Icon from './Icon.astro';
import { site } from '../data/site';

// "[...]" in the configured headline marks words to highlight.
const headlineParts = site.hero.headline.split(/\[(.+?)\]/);
---

<section id="home" class="hero container" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title">
      {headlineParts.map((part, i) => (i % 2 ? <span class="accent">{part}</span> : part))}
    </h1>
    <p class="muted">{site.hero.description}</p>
    <div class="actions">
      <a class="btn" href="/#contacts">Contact me !!</a>
      <a class="btn btn--muted" href={cvUrl} download="Farhat_Anjam_CV.pdf">
        <Icon name="download" /> Download CV
      </a>
    </div>
  </div>

  <div class="visual">
    <div class="portrait">
      <svg class="logo-outline" viewBox="0 0 53 53" aria-hidden="true" focusable="false">
        <path d="M1 15h24v11H12v14h13v12H1Z"></path>
        <path d="M26 2h25v37H26V27h13V13H26Z"></path>
      </svg>
      <span class="dots" aria-hidden="true"></span>
      <Image
        src={portrait}
        alt={site.hero.portraitAlt}
        widths={[400, 640, 920]}
        sizes="(min-width: 64rem) 460px, (min-width: 48rem) 45vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    {
      site.status && (
        <p class="status">
          <span class="status-mark" aria-hidden="true" />
          <span>
            {site.status.label} <strong>{site.status.value}</strong>
          </span>
        </p>
      )
    }
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.15fr 1fr;
      gap: 2rem;
    }
  }

  h1 {
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .intro p {
    max-width: 30rem;
    margin-block: 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .visual {
    width: min(100%, 29rem);
    margin-inline: auto;
  }

  .portrait {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--color-text-muted);
  }

  .portrait :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    filter: grayscale(0.4);
  }

  .logo-outline {
    position: absolute;
    left: -2%;
    top: 22%;
    width: 38%;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    pointer-events: none;
  }

  .dots {
    --dot-gap: 1.1rem;
    right: 0;
    top: 50%;
    z-index: 2;
    width: 5.5rem;
    height: 5.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline: 4%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-text-muted);
    border-top: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .status strong {
    color: var(--color-text);
  }

  .status-mark {
    flex: none;
    width: 1rem;
    height: 1rem;
    background: var(--color-accent);
  }
</style>
