---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../lib/projects';

interface Props {
  projects: Project[];
  headingLevel?: 2 | 3;
}

const { projects, headingLevel } = Astro.props;
---

<ul class="projects-grid" role="list" data-projects-grid>
  {
    projects.map((project) => (
      <li data-category={project.data.category}>
        <ProjectCard project={project} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }

  .projects-grid > li {
    display: grid;
    height: 100%;
  }

  .projects-grid > li[hidden] {
    display: none;
  }
</style>
