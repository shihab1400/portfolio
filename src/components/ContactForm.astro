---
import { CONTACT_LIMITS, HONEYPOT_FIELD } from '../lib/contact';
---

<form class="contact-form" action="/api/contact" method="post" data-contact-form>
  <div class="field">
    <label for="contact-name">Name <span class="req" aria-hidden="true">*</span></label>
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      maxlength={CONTACT_LIMITS.name}
      aria-describedby="contact-name-error"
    />
    <p class="error" id="contact-name-error" data-error-for="name"></p>
  </div>

  <div class="field">
    <label for="contact-company">Company name <span class="optional">(optional)</span></label>
    <input
      id="contact-company"
      name="company"
      type="text"
      autocomplete="organization"
      maxlength={CONTACT_LIMITS.company}
      aria-describedby="contact-company-error"
    />
    <p class="error" id="contact-company-error" data-error-for="company"></p>
  </div>

  <div class="field">
    <label for="contact-email">Email address <span class="req" aria-hidden="true">*</span></label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      spellcheck="false"
      required
      maxlength={CONTACT_LIMITS.email}
      aria-describedby="contact-email-error"
    />
    <p class="error" id="contact-email-error" data-error-for="email"></p>
  </div>

  <div class="field">
    <label for="contact-message">Message <span class="req" aria-hidden="true">*</span></label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      minlength={CONTACT_LIMITS.messageMin}
      maxlength={CONTACT_LIMITS.message}
      aria-describedby="contact-message-error"></textarea>
    <p class="error" id="contact-message-error" data-error-for="message"></p>
  </div>

  {/* Honeypot: hidden from people and assistive tech; bots tend to fill every field. */}
  <div class="hp" aria-hidden="true">
    <label for="contact-website">Leave this field empty</label>
    <input id="contact-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="hint muted">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>

  <button class="btn submit" type="submit" data-submit>
    <span data-submit-label>Send message</span>
  </button>

  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  import {
    normalizeContact,
    validateContact,
    type ContactErrors,
    type ContactField,
    type ContactResponse,
  } from '../lib/contact';

  const FIELDS: ContactField[] = ['name', 'company', 'email', 'message'];

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    // Script is running, so take over validation from the browser for consistent messages.
    form.noValidate = true;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    let attempted = false;
    let sending = false;

    const control = (field: ContactField) =>
      form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement;

    const readValues = () =>
      normalizeContact(Object.fromEntries(new FormData(form)) as Record<string, unknown>);

    function showErrors(errors: ContactErrors) {
      for (const field of FIELDS) {
        const input = control(field);
        const message = errors[field] ?? '';
        form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!.textContent = message;
        if (message) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    }

    function setStatus(kind: 'success' | 'error' | '', message: string) {
      status.dataset.kind = kind;
      status.textContent = message;
    }

    // After the first submit attempt, re-validate as the visitor corrects fields.
    form.addEventListener('input', () => {
      if (attempted) showErrors(validateContact(readValues()));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      attempted = true;

      const values = readValues();
      const errors = validateContact(values);
      showErrors(errors);
      const firstInvalid = FIELDS.find((field) => errors[field]);
      if (firstInvalid) {
        setStatus('error', 'Error: please fix the highlighted fields.');
        control(firstInvalid).focus();
        return;
      }

      sending = true;
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      submitLabel.textContent = 'Sending…';
      setStatus('', 'Sending your message…');

      try {
        const payload = { ...values, website: String(new FormData(form).get('website') ?? '') };
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await response.json().catch(() => null)) as ContactResponse | null;

        if (response.ok && result?.ok) {
          form.reset();
          attempted = false;
          showErrors({});
          setStatus('success', `Success: ${result.message}`);
        } else {
          if (result?.errors) showErrors(result.errors);
          setStatus(
            'error',
            `Error: ${result?.message ?? 'Your message could not be sent. Please try again later.'}`,
          );
        }
      } catch {
        setStatus('error', 'Error: network problem. Check your connection and try again.');
      } finally {
        sending = false;
        submit.disabled = false;
        form.removeAttribute('aria-busy');
        submitLabel.textContent = 'Send message';
      }
    });
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  label {
    font-weight: 500;
  }

  .req {
    color: var(--color-accent);
  }

  .optional {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  input,
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 0;
    background: var(--color-bg);
    color: var(--color-text);
    transition: border-color 0.2s var(--ease);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0;
    border-color: var(--color-accent);
  }

  [aria-invalid='true'] {
    border-color: var(--color-danger);
    border-width: 2px;
  }

  .error {
    min-height: 0;
    color: var(--color-danger);
    font-size: 0.875rem;
  }

  .error:empty {
    display: none;
  }

  .hint {
    font-size: 0.875rem;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    justify-self: start;
  }

  .status:empty {
    display: none;
  }

  .status {
    padding: 0.75rem;
    border: 1px solid var(--color-text-muted);
  }

  .status[data-kind='success'] {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .status[data-kind='error'] {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }
</style>
