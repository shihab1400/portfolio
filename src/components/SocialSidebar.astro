---
import Icon from './Icon.astro';
import { socialLinks } from '../data/social-links';
---

<aside class="social-sidebar" aria-label="Social profiles">
  <span class="line" aria-hidden="true"></span>
  <ul role="list">
    {
      socialLinks.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            <Icon name={link.icon} size={32} label={`${link.label} (opens in a new tab)`} />
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  /* Desktop only: hidden wherever the content column would be too close to the edge. */
  .social-sidebar {
    display: none;
  }

  @media (min-width: 75rem) {
    .social-sidebar {
      position: fixed;
      top: 0;
      left: 1rem;
      z-index: 60;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      width: 2.75rem;
    }
  }

  .line {
    width: 1px;
    height: 11rem;
    background: var(--color-text-muted);
  }

  ul {
    display: flex;
    flex-direction: column;
  }

  a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-text-muted);
    transition: color 0.2s var(--ease);
  }

  a:hover {
    color: var(--color-accent);
  }
</style>
