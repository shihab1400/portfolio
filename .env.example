# Copy to .env for local development. Never commit real values.

# Public production origin, used for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://your-domain.example

# Gmail account that sends contact form emails (server-side only).
SMTP_USER=you@gmail.com

# 16-character Gmail App Password for SMTP_USER, not your regular Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_PASS=your-16-char-app-password

# Address that receives contact form submissions.
CONTACT_TO=you@example.com
